# Copy to .env and replace both placeholders before starting Docker.
# Generate values with: openssl rand -hex 32
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=replace_with_random_hex_password
POSTGRES_DB=crm_db

# Local Python development defaults to an ephemeral key if this is omitted.
# Keep a stable random value here so sessions survive backend restarts.
SECRET_KEY=replace_with_random_32_byte_or_longer_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
APP_ENV=development
COOKIE_SECURE=false

# Local backend database configuration. Docker Compose sets its own database URL.
# DATABASE_URL=postgresql+psycopg://crm_user:replace_with_random_hex_password@localhost:5432/crm_db
# DATABASE_URL=sqlite:///./crm.db

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Optional external AI provider. The CRM currently uses deterministic rule-based queries.
LLM_PROVIDER=mock
LLM_API_KEY=

# Optional queue/cache URL; no current feature depends on Redis.
REDIS_URL=redis://localhost:6379/0
